# Port HTTP (Render/Railway fournissent PORT automatiquement)
PORT=3000
# Postgres / Supabase : chaîne "Connection string" (Transaction pooler recommandé). Vide => fichier JSON local data/store.json
DATABASE_URL=
# Secret des sessions (JWT). Si vide, un secret est généré dans data/jwt-secret.txt
JWT_SECRET=
# Secondes d'attente avant de compléter la file avec un bot
BOT_FILL_SECONDS=15
# Connexion Google (facultatif) : ID client OAuth « Application Web » créé sur console.cloud.google.com
# Origines JavaScript autorisées = https://ton-domaine (HTTPS obligatoire, sauf http://localhost:3000 pour tester)
GOOGLE_CLIENT_ID=
# Administrateurs (tous les skins + panneau admin), pseudos séparés par des virgules
ADMIN_USERS=Aluego
