# Port HTTP (Render/Railway fournissent PORT automatiquement)
PORT=3000
# Postgres / Supabase : chaîne "Connection string" (Transaction pooler recommandé). Vide => fichier JSON local data/store.json
DATABASE_URL=
# Secret des sessions (JWT). Si vide, un secret est généré dans data/jwt-secret.txt
JWT_SECRET=
# Secondes d'attente avant de compléter la file avec un bot
BOT_FILL_SECONDS=15
# Clé admin (à entrer une fois dans le profil d'un joueur). Si vide : générée dans data/admin-key.txt
ADMIN_KEY=
# Connexion Google (optionnelle, en plus du mode sans compte). Client ID OAuth « Application Web » de Google Cloud.
GOOGLE_CLIENT_ID=
# E-mails Google des administrateurs (admin d'office à la connexion, tous les skins, panneau admin)
ADMIN_EMAILS=
# Pseudos réservés à l'admin (ne peuvent être pris qu'avec la clé admin, admin d'office)
ADMIN_NAMES=Aluego,Alugo
